# Copie para .env e preencha. Segredos vazios NÃO são aceitos: toda checagem
# de segredo no app falha fechada (recusa) se a variável estiver vazia.

# ---- Banco ----
# Rodando nativo (pnpm dev) contra o Postgres do compose:
DATABASE_URL=postgresql://ijcrm:ijcrm@localhost:5432/ijcrm?schema=public

# ---- App ----
APP_URL=http://localhost:3000
# Sessões ficam no banco (tabela sessao); não há segredo de sessão.
# Primeiro admin: ADMIN_NOME=... ADMIN_EMAIL=... ADMIN_SENHA=... pnpm admin:criar

# ---- WhatsApp / Evolution API (GAB-28) ----
# Regra para EVOLUTION_API_KEY e EVOLUTION_WEBHOOK_SECRET: o app só aceita segredo com
# 32+ caracteres e sem o prefixo "troque-me"; fora disso trata como ausente (webhook 401,
# envio falha). CRON_SECRET segue a mesma regra (GAB-41: /api/cron/* responde 401).
# Nativo (pnpm dev): localhost. Dentro do compose o app recebe http://evolution:8080.
EVOLUTION_API_URL=http://localhost:8080
# Chave global da Evolution (AUTHENTICATION_API_KEY no compose) e token da instância.
# Obrigatório, gerar com: openssl rand -hex 32
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=ij-crm
# Segredo que a Evolution manda no header `x-webhook-secret` do webhook (configurado em
# `webhook.headers` da instância — README). Obrigatório, gerar com: openssl rand -hex 32
EVOLUTION_WEBHOOK_SECRET=
# JID do grupo de vendas (ex: 1203630xxxxxxx@g.us). Qualquer outro chat é ignorado;
# vazio = webhook responde 503.
GRUPO_JID=
# Timeout do envio à Evolution em ms (5000–120000; padrão 60000).
# GAB-42: GRUPO_JID, LLM_PROVEDOR/modelos/limiares e este timeout também são editáveis em
# Gestão → Admin; o valor salvo lá vence o daqui (README "Admin: configuração técnica e logs").
# EVOLUTION_TIMEOUT_ENVIO_MS=60000

# ---- Safe mode ----
# NUNCA defina como true fora de produção. Ausente/qualquer outro valor = envios só são logados.
# Produção usa .env.prod.example (único lugar com true) — ver docs/runbook.md.
# NOTIFICATIONS_ENABLED=true

# ---- LLM (GAB-34 / GAB-39 / GAB-45) ----
# Provedor da extração: openai (padrão; produção), anthropic (alternativa) ou mock
# (sem rede/custo; dev e testes — devolve as fixtures de src/lib/llm/fixtures/extracao.ts;
# recusado em produção). Trocar de provedor: README "Provedor de LLM".
LLM_PROVEDOR=mock
# Chave do provedor escolhido. Vazia → cada mensagem #crm vai para FALHA com
# "LLM SEM_CHAVE" e o grupo recebe "❌ ... (ref: ...)"; nada quebra.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Vazio = padrão do provedor: gpt-6.1-sol (GPT-6.1 Sol, raciocínio low) na openai,
# claude-haiku-5-5 na anthropic (claude-sonnet-5-5 se precisar de mais qualidade).
# Modelo de outro provedor (ex.: claude-* com openai) → FALHA "PROVEDOR_INVALIDO".
LLM_EXTRACAO_MODELO=
# Abaixo desta confiança (0–1) o card criado pelo WhatsApp nasce com "revisar".
LLM_LIMIAR_CONFIANCA=0.7
# Mensagens SEM #crm (GAB-39, README "Mensagens sem #crm"): o classificador usa o mesmo
# provedor; modelo vazio = o da extração (modelo de outro provedor é ignorado).
LLM_CLASSIFICACAO_MODELO=
# relevante com confiança abaixo disto → descartada sem persistir.
LLM_LIMIAR_CLASSIFICADOR=0.7
# Sem #crm, só cria/atualiza card com confiança da extração ≥ isto; abaixo → PENDENTE_REVISAO.
LLM_LIMIAR_SEM_TAG=0.85

# ---- Alerta de sem crédito na LLM (GAB-46) ----
# JID (número@s.whatsapp.net ou grupo@g.us) de operações que recebe "⚠️ Sem crédito na API de LLM ..."
# quando uma chamada falha com SEM_CREDITO (cooldown 6 h; 5 min se o envio falhar).
# Vazio = alerta desligado (o banner para gestor/admin no app continua). Respeita NOTIFICATIONS_ENABLED.
ALERTA_OPS_JID=

# ---- Cron (GAB-41) ----
# Gerar com: openssl rand -hex 32
CRON_SECRET=troque-me-openssl-rand-hex-32
