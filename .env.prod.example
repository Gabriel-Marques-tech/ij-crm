# .env de PRODUÇÃO (compose.prod.yml). Na VPS: cp .env.prod.example .env, preencha
# e `chmod 600 .env`. Guarde uma cópia offline (gerenciador de senhas da IJ): sem
# ela, um backup restaurado numa VPS nova não tem como subir (runbook §3).
#
# Regra de segredo (mesma do app, src/lib/config/env.ts): ≥ 32 caracteres e sem o
# prefixo "troque-me". O scripts/deploy.sh recusa o deploy se algum estiver fraco.
# Gere cada um com: openssl rand -hex 32   (hex: seguro dentro de URL, sem escape)

# ---- Domínio / HTTPS (Caddy + Let's Encrypt) ----
# O registro DNS (A/AAAA) precisa apontar para a VPS ANTES do 1º deploy.
APP_DOMAIN=crm.exemplo.com.br
# Email da conta ACME (avisos de expiração do Let's Encrypt). Obrigatório.
ACME_EMAIL=ti@exemplo.com.br
# Portas publicadas pelo Caddy. Só mude para teste local.
# HTTP_PORT=80
# HTTPS_PORT=443

# ---- Bancos ----
# Obrigatório, gerar com openssl rand -hex 32 (vai dentro da DATABASE_URL do app).
POSTGRES_PASSWORD=
# Obrigatório, gerar com openssl rand -hex 32 (banco interno da Evolution).
EVOLUTION_DB_PASSWORD=
# Obrigatório, gerar com openssl rand -hex 32 (requirepass do Redis da Evolution).
EVOLUTION_REDIS_PASSWORD=

# ---- WhatsApp / Evolution API ----
# Sem rota pública: porta só em 127.0.0.1 da VPS, acesso por túnel SSH (runbook §5).
# EVOLUTION_HOST_PORT=8080
# Chave global da Evolution. Obrigatório, gerar com openssl rand -hex 32
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=ij-crm
# Header `x-webhook-secret` que a Evolution manda ao app. Obrigatório, gerar com openssl rand -hex 32
EVOLUTION_WEBHOOK_SECRET=
# JID do grupo de vendas (termina em @g.us) — descoberto depois de ler o QR (runbook §5).
# Vazio = webhook responde 503 (nada é processado).
GRUPO_JID=

# ---- Safe mode ----
# true só no .env da VPS, e só no go-live (com o número dedicado conectado).
# Em qualquer outro ambiente fica false/ausente (runbook §6).
NOTIFICATIONS_ENABLED=false

# ---- LLM (GAB-34 / GAB-39 / GAB-45) ----
# Provedor da extração: openai (padrão de produção: GPT-6.1 Sol, raciocínio low) ou
# anthropic (alternativa). mock é recusado em produção. Trocar: runbook §10.
LLM_PROVEDOR=openai
# Chave do provedor escolhido (OpenAI: projeto com crédito pré-pago e auto-reload
# DESLIGADO — runbook §10). Vazia → cada mensagem #crm vai para FALHA com
# "LLM SEM_CHAVE" e o grupo recebe "❌ ... (ref: ...)"; nada quebra.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Vazio = padrão do provedor (gpt-6.1-sol / claude-haiku-5-5). Ao trocar de provedor,
# troque ou esvazie também este valor: modelo de outro provedor → FALHA "PROVEDOR_INVALIDO".
LLM_EXTRACAO_MODELO=
# Abaixo desta confiança (0–1) o card criado pelo WhatsApp nasce com "revisar".
LLM_LIMIAR_CONFIANCA=0.7
LLM_CLASSIFICACAO_MODELO=claude-haiku-5-5

# ---- Cron (GAB-41) ----
# Header `x-cron-secret` de /api/cron/* (scripts/cron-reprocessar.sh) — é o ÚNICO
# controle de acesso dessas rotas. Mesma regra: ≥ 32 chars, sem "troque-me".
# Obrigatório, gerar com openssl rand -hex 32
CRON_SECRET=

# ---- Backup off-site (bloqueio de go-live, runbook checklist) ----
# Remote do rclone (configurado com `rclone config` no host), ex.: b2:ij-crm-backups.
# Vazio = backup só no disco da VPS (backup.sh avisa no log).
BACKUP_REMOTE=

# ---- Imagens (opcional) ----
# O deploy.sh marca as imagens com o commit; não precisa definir APP_TAG aqui.
# APP_IMAGE=ij-crm/app
# OPS_IMAGE=ij-crm/ops
