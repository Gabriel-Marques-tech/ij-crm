// ij-crm — schema núcleo (design doc §4.2)
// Nomes de domínio em português; tabelas/colunas em snake_case via @map.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pg_trgm/unaccent: busca de CANDIDATOS por nome (§4.3). Autolink nunca usa isso.
  extensions = [pg_trgm(schema: "public"), unaccent(schema: "public")]
}

// ---------------------------------------------------------------- enums

enum Papel {
  ADMIN
  GESTOR
  VENDEDOR
  // Somente leitura (outras áreas): vê Kanban/Tabela/Calendário/Semana/Contatos/
  // Empresas/Ranking, não escreve nada nem é responsável de card.
  VISUALIZADOR
  // Membro do time de projetos (GAB-82): mesmas permissões de card que VENDEDOR;
  // o lado (área PROJETOS) vem junto. Ver src/lib/auth/areas.ts.
  PROJETOS
}

// Lado do usuário no ciclo (spec fase 2 §4.12). null = nenhum (gestão/admin/visualizador).
enum Area {
  VENDAS
  PROJETOS
}

// GAB-97: onde a pessoa entra no CRM. GERAL = Painel.
enum AreaEntrada {
  VENDAS
  PROJETOS
  GERAL
}

// Cargo DENTRO da área (não é papel de permissão). Novo cargo da IJ = só
// `ALTER TYPE "Cargo" ADD VALUE` (aditivo), sem mexer em linhas existentes.
enum Cargo {
  GP // GP da área: age em nome do seu lado na caneta da proposta
}

enum TipoContatoPonto {
  TELEFONE
  EMAIL
}

enum TipoTerminal {
  GANHO
  PERDIDO
}

/// GAB-81: marcos FIXOS do ciclo único do Projeto (spec fase 2 §4.2). Cada marco é
/// uma fase só (único no banco) num quadro fixo: Vendas = PROPOSTA,
/// MONTANDO_CONTRATO, GANHO, PERDIDO; Projetos = HANDOFF, EXECUCAO, FINALIZADO.
/// Fase sem marco = subfase livre da Gestão. Regras em src/lib/fases/marcos.ts.
enum Marco {
  PROPOSTA
  MONTANDO_CONTRATO
  GANHO
  PERDIDO
  HANDOFF
  EXECUCAO
  FINALIZADO
}

enum Origem {
  COLD_CALL
  RD
  INDICACAO
  EVENTO
  OUTRO
}

enum CriadoVia {
  WHATSAPP
  UI
  IMPORT
}

enum OrigemTransicao {
  WHATSAPP
  UI
  IMPORT
  SISTEMA
}

enum TipoTimeline {
  CRIACAO
  MOVIMENTACAO
  CAMPO_ALTERADO
  NOTA
  MENSAGEM_WHATSAPP
  IMPORT
  VINCULO_PROJETO
  EXCLUSAO     // card foi para a lixeira (GAB-36)
  RESTAURACAO  // card voltou da lixeira (GAB-36)
  PRAZO        // prazo do card criado/concluído (GAB-51); payload.evento = "criado" | "concluido"
  ANEXO        // GAB-84: payload.evento = "adicionado" | "excluido" | "restaurado" | "apagado"; payload.anexoId, payload.nome
  PROPOSTA     // GAB-86: proposta do Projeto; payload.evento = "criada" | "versao_salva" (+ numero, nota). A caneta (GAB-87) acrescenta eventos.
  HANDOFF      // GAB-93: payload.evento = "gp_designado" | "item_marcado" | "item_desmarcado" | "resumo_salvo" | "contrato_definido"
  EXECUCAO     // GAB-95: payload.evento = "cronograma_copiado" | "entrega_adicionada" | "entrega_feita" | "entrega_desmarcada" | "data_ajustada" | "checkin"
}

// GAB-84: tipo do anexo, detectado pelos BYTES no servidor (src/lib/anexos/tipos.ts).
enum TipoAnexo {
  PDF
  DOCX
  MARKDOWN
  TEXTO
  PNG
  JPEG
  WEBP
}

/// GAB-85 (spec fase 2 §4.14, Q23): como o lead reagiu ao contato, inferido pela LLM
/// nas mensagens #crm (extracao.v3). Espelha SENTIMENTOS de src/lib/llm/prompts/extracao.v3.ts.
enum Sentimento {
  POSITIVO
  NEUTRO
  NEGATIVO
}

/// GAB-86: status da proposta (spec fase 2 §4.3). A caneta/pingue-pongue (GAB-87) move
/// entre RASCUNHO → EM_ANALISE ⇄ EM_AJUSTE → PRONTA_PARA_ENVIO (ou INVIAVEL); o resto é do envio (GAB-89).
enum StatusProposta {
  RASCUNHO          // com vendas, antes de ir a projetos
  EM_ANALISE        // caneta com projetos
  EM_AJUSTE         // voltou para vendas
  PRONTA_PARA_ENVIO // consenso
  ENVIADA
  ACEITA
  RECUSADA
  REVISAO_PEDIDA
  INVIAVEL          // GAB-87: projetos marcou inviável (com motivo); o Projeto foi para Perdido
}

enum StatusMensagem {
  RECEBIDA
  PROCESSANDO // GAB-34: reivindicada por `processarMensagem` (LLM em andamento)
  CLASSIFICADA_IRRELEVANTE
  PROCESSADA
  FALHA
  PENDENTE_REVISAO
}

// ---------------------------------------------------------------- usuários

// Kanban interno do projeto (tasks do time de projetos). Seis status fixos, como os
// padrões do Linear; Backlog e Cancelada ficam recolhidas no quadro.
enum StatusTarefa {
  BACKLOG
  A_FAZER
  EM_ANDAMENTO
  EM_REVISAO
  FEITA
  CANCELADA
}

enum PrioridadeTarefa {
  SEM_PRIORIDADE
  URGENTE
  ALTA
  MEDIA
  BAIXA
}

model Usuario {
  id                String    @id @default(cuid())
  nome              String
  email             String    @unique
  senhaHash         String?   @map("senha_hash") // null = ainda sem senha (convite pendente)
  papel             Papel     @default(VENDEDOR)
  // GAB-82: lado e cargos. Coerência com o papel garantida em src/lib/auth/areas.ts
  // (VENDEDOR → VENDAS, PROJETOS → PROJETOS, VISUALIZADOR → nenhum).
  area              Area?
  cargos            Cargo[]   @default([])
  // GAB-97: área de entrada de ADMIN, GESTOR sem área e VISUALIZADOR (null = Geral). Não dá lado.
  areaEntrada       AreaEntrada? @map("area_entrada")
  telefoneWhatsapp  String?   @unique @map("telefone_whatsapp")
  whatsappLid       String?   @unique @map("whatsapp_lid")
  ativo             Boolean   @default(true)
  conviteTokenHash  String?   @unique @map("convite_token_hash") // sha256 do token; nunca o token em claro
  conviteExpiraEm   DateTime? @map("convite_expira_em")
  // Esqueci a senha (GAB-43): pedido visível ao gestor; link gerado por ele (só o hash, 1 h, uso único).
  redefinicaoPedidaEm   DateTime? @map("redefinicao_pedida_em")
  redefinicaoTokenHash  String?   @unique @map("redefinicao_token_hash")
  redefinicaoExpiraEm   DateTime? @map("redefinicao_expira_em")
  // Preferências de visualização do próprio usuário (JSON versionado; ver src/lib/preferencias).
  preferencias      Json?
  criadoEm          DateTime  @default(now()) @map("criado_em")
  atualizadoEm      DateTime  @updatedAt @map("atualizado_em")

  projetos     Projeto[]   @relation("responsavel")
  /// GAB-81: Projetos que esta pessoa ganhou (vendedor no momento do ganho).
  vendas            Projeto[]   @relation("vendedor")
  transicoes        TransicaoFase[]
  timeline          Timeline[]
  mensagensBrutas   MensagemBruta[]
  mensagensResolvidas MensagemBruta[] @relation("resolvidaPor")
  sessoes           Sessao[]
  importPrevias     ImportPrevia[]
  foto              UsuarioFoto?
  configuracoes     Configuracao[]
  oauthCodigos      OauthCodigo[]
  mcpConexoes       McpConexao[]
  resumosJanela     ResumoJanela[]
  propostasCriadas  Proposta[]       @relation("propostaCriadaPor")
  propostasRascunho Proposta[]       @relation("propostaRascunhoPor")
  propostasCaneta   Proposta[]       @relation("propostaCaneta")
  periodosCaneta    PropostaCaneta[]
  versoesProposta   PropostaVersao[]
  prazos            Prazo[]          @relation("prazoResponsavel")
  prazosCriados     Prazo[]          @relation("prazoCriadoPor")
  prazosFeitos      Prazo[]          @relation("prazoFeitoPor")
  anexos            Anexo[]          @relation("anexoAutor")
  anexosExcluidos   Anexo[]          @relation("anexoExcluidoPor")
  avisos            Aviso[]
  handoffsComoGp    ProjetoHandoff[] @relation("handoffGp")
  handoffsResumo    ProjetoHandoff[] @relation("handoffResumoPor")
  ajustesDeEntrega  EntregaAjuste[]
  checkins          ProjetoCheckin[]
  comentariosProposta   PropostaComentario[] @relation("comentarioAutor")
  comentariosResolvidos PropostaComentario[] @relation("comentarioResolvidoPor")
  tarefasResponsavel    Tarefa[]             @relation("tarefaResponsavel")
  tarefasCriadas        Tarefa[]             @relation("tarefaCriadaPor")
  membro                Membro?              @relation("membroConta")
  equipes               ProjetoMembro[]      @relation("equipeUsuario")
  historicoOrg          HistoricoOrg[]
  demandasRegistradas   Demanda[]
  eventosCriados        EventoAgenda[]
  ausenciasRegistradas  Ausencia[]

  @@map("usuario")
}

// Foto de perfil 1:1 (GAB-43): fora de `usuario` para a linha seguir leve; entra no pg_dump.
// Só WebP/JPEG 256×256 validados no servidor (src/lib/perfil/imagem.ts).
model UsuarioFoto {
  usuarioId    String   @id @map("usuario_id")
  bytes        Bytes
  mime         String
  atualizadoEm DateTime @default(now()) @map("atualizado_em")

  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("usuario_foto")
}

// Sessão no banco (não JWT): desativar usuário derruba o acesso na hora.
model Sessao {
  id        String   @id // random 32 bytes hex — é o valor do cookie
  usuarioId String   @map("usuario_id")
  expiraEm  DateTime @map("expira_em")
  criadoEm  DateTime @default(now()) @map("criado_em")
  // GAB-43: sessões ativas. Último uso é gravado no máximo a cada N minutos (sessao.ts).
  userAgent   String?  @map("user_agent")
  ultimoUsoEm DateTime @default(now()) @map("ultimo_uso_em")

  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEm])
  @@map("sessao")
}

// ---------------------------------------------------------------- MCP / OAuth (GAB-83)
// Conector MCP remoto: o CRM é o servidor de autorização (OAuth 2.1 + PKCE) e o
// servidor de recurso (`/api/mcp`). Tokens e códigos só como sha256, como a sessão.

/// Cliente OAuth registrado por Dynamic Client Registration (claude.ai, Claude Code…). Público: sem segredo.
model OauthCliente {
  id           String   @id // client_id: aleatório, público
  nome         String // client_name do registro, mostrado na autorização e no perfil
  redirectUris String[] @map("redirect_uris")
  criadoEm     DateTime @default(now()) @map("criado_em")
  /// 1ª troca de código por token. Nunca conectou e tem mais de 7 dias → a limpeza apaga.
  conectouEm   DateTime? @map("conectou_em")

  codigos  OauthCodigo[]
  conexoes McpConexao[]

  @@index([criadoEm])
  @@map("oauth_cliente")
}

/// Código de autorização: uso único, minutos de vida, preso ao PKCE (S256) e ao redirect_uri.
model OauthCodigo {
  id            String   @id // sha256 do código
  clienteId     String   @map("cliente_id")
  usuarioId     String   @map("usuario_id")
  redirectUri   String   @map("redirect_uri")
  codeChallenge String   @map("code_challenge")
  escopo        String
  expiraEm      DateTime @map("expira_em")
  criadoEm      DateTime @default(now()) @map("criado_em")

  cliente OauthCliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  usuario Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([expiraEm])
  @@map("oauth_codigo")
}

/// Uma conexão MCP ativa (o que o perfil lista e revoga). O refresh gira a cada uso: os dois hashes são trocados.
model McpConexao {
  id              String   @id @default(cuid())
  usuarioId       String   @map("usuario_id")
  clienteId       String   @map("cliente_id")
  escopo          String
  acessoHash      String   @unique @map("acesso_hash")
  acessoExpiraEm  DateTime @map("acesso_expira_em")
  refreshHash     String   @unique @map("refresh_hash")
  refreshExpiraEm DateTime @map("refresh_expira_em")
  /// Refresh já girado: se aparecer de novo, foi roubado/replay → a conexão é apagada.
  refreshAnteriorHash String? @unique @map("refresh_anterior_hash")
  criadoEm        DateTime @default(now()) @map("criado_em")
  ultimoUsoEm     DateTime @default(now()) @map("ultimo_uso_em")

  usuario Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cliente OauthCliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([refreshExpiraEm])
  @@map("mcp_conexao")
}

// ---------------------------------------------------------------- empresas / contatos

model Empresa {
  id            String    @id @default(cuid())
  nome          String
  cnpj          String?   @unique
  dominioEmail  String?   @map("dominio_email")
  cidade        String?
  estado        String?
  site          String?
  observacoes   String?
  mergedIntoId  String?   @map("merged_into_id")
  deletadoEm    DateTime? @map("deletado_em")
  criadoEm      DateTime  @default(now()) @map("criado_em")
  atualizadoEm  DateTime  @updatedAt @map("atualizado_em")

  mergedInto    Empresa?  @relation("empresaMerge", fields: [mergedIntoId], references: [id])
  mergedFrom    Empresa[] @relation("empresaMerge")
  contatos      Contato[]
  projetos Projeto[]

  @@index([nome])
  @@index([nome(ops: raw("gin_trgm_ops"))], type: Gin, map: "empresa_nome_trgm_idx")
  @@index([dominioEmail])
  @@index([mergedIntoId])
  @@map("empresa")
}

model Contato {
  id            String    @id @default(cuid())
  nome          String
  empresaId     String?   @map("empresa_id")
  cargo         String?
  observacoes   String?
  mergedIntoId  String?   @map("merged_into_id")
  deletadoEm    DateTime? @map("deletado_em")
  criadoEm      DateTime  @default(now()) @map("criado_em")
  atualizadoEm  DateTime  @updatedAt @map("atualizado_em")

  empresa       Empresa?  @relation(fields: [empresaId], references: [id])
  mergedInto    Contato?  @relation("contatoMerge", fields: [mergedIntoId], references: [id])
  mergedFrom    Contato[] @relation("contatoMerge")
  pontos        ContatoPonto[]
  projetos Projeto[]

  @@index([nome])
  @@index([nome(ops: raw("gin_trgm_ops"))], type: Gin, map: "contato_nome_trgm_idx")
  @@index([empresaId])
  @@index([mergedIntoId])
  @@map("contato")
}

model ContatoPonto {
  id               String           @id @default(cuid())
  contatoId        String           @map("contato_id")
  tipo             TipoContatoPonto
  valorNormalizado String           @map("valor_normalizado")
  valorOriginal    String           @map("valor_original")
  criadoEm         DateTime         @default(now()) @map("criado_em")

  contato          Contato          @relation(fields: [contatoId], references: [id], onDelete: Cascade)

  @@unique([tipo, valorNormalizado])
  @@index([contatoId])
  @@map("contato_ponto")
}

// ---------------------------------------------------------------- pipeline / fases

model Pipeline {
  id     String @id @default(cuid())
  chave  String @unique
  nome   String
  ordem  Int    @default(0)

  fases         Fase[]
  projetos Projeto[]

  @@map("pipeline")
}

model Fase {
  id                String        @id @default(cuid())
  pipelineId        String        @map("pipeline_id")
  chave             String
  nome              String
  ordem             Int
  isTerminal        Boolean       @default(false) @map("is_terminal")
  tipoTerminal      TipoTerminal? @map("tipo_terminal")
  cor               String?
  limiteDiasAlerta  Int?          @map("limite_dias_alerta")
  /// GAB-81: marco fixo do ciclo (null = subfase). Marco não é apagado, arquivado,
  /// reordenado fora da ordem canônica nem muda de tipo terminal.
  marco             Marco?        @unique
  // Fase com histórico (transicao_fase.de_fase_id é RESTRICT) não pode ser
  // apagada: é arquivada. Some do Kanban e da criação de cards, mantém o histórico.
  arquivadaEm       DateTime?     @map("arquivada_em")
  criadoEm          DateTime      @default(now()) @map("criado_em")
  atualizadoEm      DateTime      @updatedAt @map("atualizado_em")

  pipeline          Pipeline      @relation(fields: [pipelineId], references: [id])
  projetos     Projeto[]
  transicoesDe      TransicaoFase[] @relation("transicaoDe")
  transicoesPara    TransicaoFase[] @relation("transicaoPara")

  @@unique([pipelineId, chave])
  @@index([pipelineId, ordem])
  @@map("fase")
}

// ---------------------------------------------------------------- projetos

model Projeto {
  id                    String     @id @default(cuid())
  pipelineId            String     @map("pipeline_id")
  faseId                String     @map("fase_id")
  titulo                String
  empresaId             String?    @map("empresa_id")
  contatoId             String?    @map("contato_id")
  responsavelId         String     @map("responsavel_id")
  origem                Origem?
  dor                   String?
  /// Texto livre do card (até 5000 caracteres, validado em `campos.ts`). Exibido como texto puro.
  descricao             String?
  orcamentoPrevisto     Decimal?   @map("orcamento_previsto") @db.Decimal(14, 2)
  propostaUrl           String?    @map("proposta_url")
  cidade                String?
  estado                String?
  valorFechado          Decimal?   @map("valor_fechado") @db.Decimal(14, 2)
  dataGanho             DateTime?  @map("data_ganho")
  motivoPerda           String?    @map("motivo_perda")
  proximaAcao           String?    @map("proxima_acao")
  proximaAcaoEm         DateTime?  @map("proxima_acao_em")
  revisar               Boolean    @default(false)
  /// GAB-89: card que já existia no deploy da trava (marcado pela migration 20261101200000)
  /// ou veio do import do Pipefy: livre da trava de Montando contrato (proposta aceita).
  isentoTravaContrato   Boolean    @default(false) @map("isento_trava_contrato")
  /// GAB-93: card que já estava no quadro Projetos no deploy (migration 20261104150000) ou veio do
  /// import do Pipefy: livre da trava de Execução (checklist + resumo de handoff).
  isentoTravaHandoff    Boolean    @default(false) @map("isento_trava_handoff")
  /// GAB-95: última entrada em Execução (ou além). Conta para o lembrete de check-in. Null = nunca entrou
  /// depois do deploy: card já em Execução naquela hora só é cobrado depois de ter entrega ou check-in.
  execucaoDesde         DateTime?  @map("execucao_desde")
  faseDesde             DateTime   @default(now()) @map("fase_desde")
  criadoVia             CriadoVia  @map("criado_via")
  // v1 (GAB-32): card de projetos gerado pelo ganho desta venda. GAB-81: o ganho não cria mais
  // card; só cards absorvidos pela migração ainda têm este campo. Coluna fica até a limpeza.
  vendaOrigemId         String?    @unique @map("origem_oportunidade_id")
  reabertaDeId          String?    @map("reaberta_de_id")
  pipefyId              String?    @unique @map("pipefy_id")
  deletadoEm            DateTime?  @map("deletado_em")
  /// GAB-81: card de projetos da v1 que a migração do ciclo único uniu à venda de
  /// origem (Timeline/TransicaoFase/prazos foram para ela). Fica soft-deletado e
  /// fora da lixeira, só como registro, até o ticket de limpeza.
  absorvidoPorId        String?    @map("absorvido_por_id")
  /// GAB-81: responsável no momento do GANHO (o card segue para Projetos e pode
  /// mudar de responsável). O ranking credita o ganho a ele; a perda vai para o
  /// responsável atual (`responsavel_id`).
  vendedorId            String?    @map("vendedor_id")
  criadoEm              DateTime   @default(now()) @map("criado_em")
  atualizadoEm          DateTime   @updatedAt @map("atualizado_em")

  pipeline              Pipeline   @relation(fields: [pipelineId], references: [id])
  fase                  Fase       @relation(fields: [faseId], references: [id])
  empresa               Empresa?   @relation(fields: [empresaId], references: [id])
  contato               Contato?   @relation(fields: [contatoId], references: [id])
  responsavel           Usuario    @relation("responsavel", fields: [responsavelId], references: [id])
  vendedor              Usuario?  @relation("vendedor", fields: [vendedorId], references: [id], onDelete: SetNull)
  vendaOrigem           Projeto?  @relation("vendaParaCardProjetos", fields: [vendaOrigemId], references: [id])
  // Card de projetos da v1 gerado pelo ganho desta venda (hoje: só a casca absorvida, GAB-81).
  cardProjetos          Projeto?  @relation("vendaParaCardProjetos")
  // SET NULL explícito: card reaberto é histórico e sobrevive à deleção definitiva da origem (GAB-36).
  reabertaDe            Projeto?  @relation("reabertura", fields: [reabertaDeId], references: [id], onDelete: SetNull)
  reaberturas           Projeto[] @relation("reabertura")
  // Apagar de vez o Projeto leva junto a casca absorvida (não tem mais histórico próprio).
  absorvidoPor          Projeto?  @relation("absorcao", fields: [absorvidoPorId], references: [id], onDelete: Cascade)
  absorvidos            Projeto[] @relation("absorcao")
  transicoes            TransicaoFase[]
  timeline              Timeline[]
  mensagensEnviadas     MensagemEnviada[]
  prazos                Prazo[]
  avisos                Aviso[]
  anexos                Anexo[]
  proposta              Proposta?
  handoff               ProjetoHandoff?
  entregas              ProjetoEntrega[]
  checkins              ProjetoCheckin[]
  lembretesCheckin      LembreteCheckin[]
  tarefas               Tarefa[]
  equipe                ProjetoMembro[]

  @@index([pipelineId, faseId])
  @@index([responsavelId])
  @@index([empresaId])
  @@index([contatoId])
  @@index([proximaAcaoEm])
  @@index([reabertaDeId])
  @@index([absorvidoPorId])
  @@index([vendedorId])
  @@map("oportunidade")
}

// TransicaoFase e Timeline são append-only. onDelete: Cascade existe SÓ para a
// "deleção definitiva" (admin, GAB-36); soft-delete nunca toca nestas tabelas.
model TransicaoFase {
  id             String          @id @default(cuid())
  projetoId      String          @map("oportunidade_id")
  deFaseId       String?         @map("de_fase_id")
  paraFaseId     String          @map("para_fase_id")
  usuarioId      String?         @map("usuario_id")
  origem         OrigemTransicao
  em             DateTime        @default(now())

  projeto        Projeto    @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  deFase         Fase?           @relation("transicaoDe", fields: [deFaseId], references: [id], onDelete: Restrict)
  paraFase       Fase            @relation("transicaoPara", fields: [paraFaseId], references: [id])
  usuario        Usuario?        @relation(fields: [usuarioId], references: [id])

  @@index([projetoId, em])
  @@index([usuarioId])
  @@index([em]) // ranking por período (GAB-44)
  @@map("transicao_fase")
}

model Timeline {
  id              String        @id @default(cuid())
  projetoId       String        @map("oportunidade_id")
  tipo            TipoTimeline
  payload         Json          @default("{}")
  usuarioId       String?       @map("usuario_id")
  mensagemBrutaId String?       @map("mensagem_bruta_id")
  em              DateTime      @default(now())
  /// GAB-83: ação feita pelo conector MCP (o Claude da pessoa), em nome de `usuario`.
  viaMcp          Boolean       @default(false) @map("via_mcp")
  /// GAB-85: nota de 1 a 5 que o vendedor deu ao contato (NOTA da tela/MCP; opcional).
  /// CHECK 1..5 na migration 20261101140000_nota_sentimento.
  nota            Int?          @db.SmallInt
  /// GAB-85: sentimento do lead lido pela LLM (MENSAGEM_WHATSAPP). Coluna própria, fora do
  /// `payload`: a purga de 90 dias do JSON da LLM (retencao.ts) não apaga o dado do painel.
  sentimento      Sentimento?

  projeto         Projeto  @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  usuario         Usuario?      @relation(fields: [usuarioId], references: [id])
  mensagemBruta   MensagemBruta? @relation(fields: [mensagemBrutaId], references: [id])

  @@index([projetoId, em])
  @@index([mensagemBrutaId])
  @@index([tipo, em]) // ranking: ações feitas por período (GAB-44)
  @@map("timeline")
}

// ---------------------------------------------------------------- whatsapp

model InboxEvento {
  eventoId   String   @id @map("evento_id")
  recebidoEm DateTime @default(now()) @map("recebido_em")
  status     String   // PROCESSADO | FALHA — setado explicitamente pelo ingest, nunca por default

  @@map("inbox_evento")
}

model MensagemBruta {
  id                  String         @id @default(cuid())
  eventoId            String         @unique @map("evento_id")
  remetenteTelefone   String?        @map("remetente_telefone")
  remetenteLid        String?        @map("remetente_lid")
  remetenteUsuarioId  String?        @map("remetente_usuario_id")
  grupoJid            String         @map("grupo_jid")
  texto               String
  mediaType           String?        @map("media_type")
  mediaUrl            String?        @map("media_url")
  respondendoEventoId String?        @map("respondendo_evento_id")
  recebidaEm          DateTime       @map("recebida_em")
  status              StatusMensagem @default(RECEBIDA)
  tentativas          Int            @default(0)
  resultadoLlm        Json?          @map("resultado_llm")
  erro                String?
  /// GAB-39: chegou sem #crm e o classificador achou relevante — limiar de extração mais alto e confirmação "↪️".
  semTag              Boolean        @default(false) @map("sem_tag")
  /// GAB-41: "Resolver manualmente" no painel (PROCESSADA sem LLM): quem e quando.
  resolvidaPorId      String?        @map("resolvida_por_id")
  resolvidaEm         DateTime?      @map("resolvida_em")
  /// GAB-85: sentimento do lead extraído junto com o resto (extracao.v3). Fica depois da purga
  /// do `resultado_llm`; "Resolver manualmente" copia para a Timeline.
  sentimento          Sentimento?
  criadoEm            DateTime       @default(now()) @map("criado_em")
  atualizadoEm        DateTime       @updatedAt @map("atualizado_em")

  remetenteUsuario    Usuario?       @relation(fields: [remetenteUsuarioId], references: [id])
  resolvidaPor        Usuario?       @relation("resolvidaPor", fields: [resolvidaPorId], references: [id], onDelete: SetNull)
  timeline            Timeline[]

  @@index([status])
  @@index([remetenteUsuarioId, recebidaEm])
  @@index([recebidaEm]) // GAB-49: remetentes de uma janela (gerarResumosPendentes)
  @@index([respondendoEventoId])
  // + índice parcial (recebida_em) WHERE resultado_llm IS NOT NULL, só na migration 20261027170100 (retenção).
  @@map("mensagem_bruta")
}

model MensagemEnviada {
