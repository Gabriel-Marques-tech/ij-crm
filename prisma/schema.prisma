// ---------------------------------------------------------------- import Pipefy (GAB-37)

// Prévia de um import: o CSV e o mapeamento de fases exatamente como o gestor
// viu. Confirmar aplica ESTA linha (hash conferido), nunca um novo upload.
// Expira em 30 min; usada uma vez.
model ImportPrevia {
  id          String    @id // token aleatório (32 bytes hex)
  usuarioId   String    @map("usuario_id")
  hash        String    // sha256(conteúdo + mapeamento canônico)
  nomeArquivo String    @map("nome_arquivo")
  conteudo    String
  mapeamento  Json
  opcoes      Json      @default("{}")
  expiraEm    DateTime  @map("expira_em")
  usadaEm     DateTime? @map("usada_em")
  criadoEm    DateTime  @default(now()) @map("criado_em")

  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([expiraEm])
  @@map("import_previa")
}

// GAB-46: estado de alertas operacionais (cooldown do aviso no WhatsApp +
// banner). Uma linha por chave; hoje só `LLM_SEM_CREDITO`.
model AlertaOperacional {
  chave              String    @id
  ativoDesde         DateTime? @map("ativo_desde")
  ultimaOcorrenciaEm DateTime? @map("ultima_ocorrencia_em")
  proximoAvisoEm     DateTime? @map("proximo_aviso_em")
  avisadoEm          DateTime? @map("avisado_em")

  @@map("alerta_operacional")
}

// ---------------------------------------------------------------- configuração (GAB-44)

// Chave → JSON validado com zod por chave (src/lib/configuracao). Linha ausente
// ou inválida = padrão do código. Genérica: GAB-42 (config técnica) reaproveita.
model Configuracao {
  chave         String   @id
  valor         Json
  atualizadoEm  DateTime @default(now()) @map("atualizado_em")
  atualizadoPor String?  @map("atualizado_por")

