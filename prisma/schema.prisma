  @@map("configuracao")
}

// ---------------------------------------------------------------- logs técnicos (GAB-42)

// Anel das últimas N chamadas do webhook (src/lib/logs). Sem corpo nem texto:
// tipo do evento, chat mascarado, status/resultado e duração.
model LogWebhook {
  id        Int      @id @default(autoincrement())
  em        DateTime @default(now())
  tipo      String?
  chat      String?
  status    Int
  resultado String
  ms        Int

  @@map("log_webhook")
}

// Anel das últimas N chamadas de LLM: modelo, tokens (incl. raciocínio), ms e
// status. `ref` = id da MensagemBruta (correlaciona com o log do servidor).
model LogLlm {
  id               Int      @id @default(autoincrement())
  em               DateTime @default(now())
  operacao         String
  provedor         String?
  modelo           String?
  tokensEntrada    Int?     @map("tokens_entrada")
  tokensSaida      Int?     @map("tokens_saida")
  tokensRaciocinio Int?     @map("tokens_raciocinio")
  ms               Int?
  status           String
  ref              String?

  @@map("log_llm")
}

// ---------------------------------------------------------------- contexto da LLM (GAB-49)

enum StatusResumo {
  GERANDO
  PRONTO
  FALHA
}

/// GAB-49: resumo por vendedor de uma janela de 12 h (00–12 / 12–24 de SP), contexto da extração na
/// janela seguinte. Gerado sob demanda (1ª mensagem da janela seguinte) com reivindicação pela chave
/// única. Só o da janela ANTERIOR à atual fica; os mais antigos são apagados (src/lib/contexto/resumo.ts).
/// Texto sem telefone/email.
model ResumoJanela {
  id           String       @id @default(cuid())
  usuarioId    String       @map("usuario_id")
  janelaInicio DateTime     @map("janela_inicio")
  status       StatusResumo @default(GERANDO)
  tentativas   Int          @default(1)
  texto        String?
  /// Código + ref da última falha (nunca texto de mensagem).
  erro         String?
  criadoEm     DateTime     @default(now()) @map("criado_em")
  atualizadoEm DateTime     @default(now()) @map("atualizado_em")

  usuario      Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, janelaInicio])
  @@index([janelaInicio])
  @@map("resumo_janela")
}

// ---------------------------------------------------------------- prazos (GAB-51)

/// Prazo ("linha de chegada" no Calendário): um DIA civil (sem hora), um
/// responsável e, opcionalmente, um card. Vendedor só mexe nos próprios;
/// gestor/admin em qualquer um (src/lib/prazos/regras.ts). Soft-delete como o
/// resto do app; card apagado de vez leva os prazos junto (cascade).
model Prazo {
  id             String    @id @default(cuid())
  titulo         String
  data           DateTime  @db.Date
  responsavelId  String    @map("responsavel_id")
  projetoId String?   @map("oportunidade_id")
  feitoEm        DateTime? @map("feito_em")
  feitoPorId     String?   @map("feito_por_id")
  criadoPorId    String    @map("criado_por_id")
  deletadoEm     DateTime? @map("deletado_em")
  criadoEm       DateTime  @default(now()) @map("criado_em")
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em")

  responsavel  Usuario       @relation("prazoResponsavel", fields: [responsavelId], references: [id])
  criadoPor    Usuario       @relation("prazoCriadoPor", fields: [criadoPorId], references: [id])
  feitoPor     Usuario?      @relation("prazoFeitoPor", fields: [feitoPorId], references: [id], onDelete: SetNull)
  projeto Projeto? @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@index([responsavelId, data]) // semana de uma pessoa (Calendário "Meu"/"Pessoa", Minha Semana)
  @@index([data]) // semana do time
  @@index([projetoId])
  @@map("prazo")
}

/// Tarefa do kanban interno do projeto: só o time de projetos vê (`podeVerTarefas`).
/// NUNCA gera Timeline do card (a Timeline aparece para Vendas). `numero` é
/// sequencial por projeto (#12), gerado na transação e nunca reaproveitado.
model Tarefa {
  id            String           @id @default(cuid())
  projetoId     String           @map("oportunidade_id")
  numero        Int
  paiId         String?          @map("pai_id") // subtarefa: um nível só
  titulo        String
  descricao     String?
  status        StatusTarefa     @default(A_FAZER)
  prioridade    PrioridadeTarefa @default(SEM_PRIORIDADE)
  posicao       Float // ordem dentro da coluna
  responsavelId String?          @map("responsavel_id") // pode ficar sem responsável
  prazo         DateTime?        @db.Date
  etiquetas     String[]         @default([])
  concluidaEm   DateTime?        @map("concluida_em")
  criadoPorId   String           @map("criado_por_id")
  deletadoEm    DateTime?        @map("deletado_em")
  criadoEm      DateTime         @default(now()) @map("criado_em")
  atualizadoEm  DateTime         @updatedAt @map("atualizado_em")

  projeto     Projeto  @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  responsavel Usuario? @relation("tarefaResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  criadoPor   Usuario  @relation("tarefaCriadaPor", fields: [criadoPorId], references: [id])
  pai         Tarefa?  @relation("subtarefas", fields: [paiId], references: [id], onDelete: Cascade)
  subtarefas  Tarefa[] @relation("subtarefas")

  @@unique([projetoId, numero])
  @@index([projetoId, status, posicao])
  @@index([responsavelId])
  @@index([paiId])
  @@map("tarefa")
}

// GAB-84: arquivo de base anexado ao Projeto (spec fase 2 §4.7). Os BYTES ficam
// no disco (`ANEXOS_DIR/<id>`, src/lib/anexos/armazenamento.ts), fora do banco;
// aqui só os metadados e o texto extraído no upload (sem LLM). `semTexto` =
// escaneado/imagem: aguarda o OCR (GAB-90). Soft-delete como os cards (lixeira).
model Anexo {
  id            String    @id
  projetoId     String    @map("oportunidade_id")
  /// Nome original, já sanitizado (sem caminho nem caracteres de controle).
  nome          String
  tipo          TipoAnexo
  mime          String
  tamanho       Int
  sha256        String
  /// Texto extraído (PDF digital, .docx, .md, .txt). Null quando `semTexto`.
  texto         String?
  semTexto      Boolean   @map("sem_texto")
  /// GAB-93: este PDF É o contrato assinado do Projeto (marcado pelo fluxo de contrato assinado ou
  /// pelo checklist de handoff; nunca deduzido do nome). No máximo um vivo por Projeto: índice único
  /// parcial `anexo_contrato_assinado_vivo_key`, só na migration 20261104150000 (o Prisma não o representa).
  contratoAssinado Boolean @default(false) @map("contrato_assinado")
  autorId       String    @map("autor_id")
  criadoEm      DateTime  @default(now()) @map("criado_em")
  deletadoEm    DateTime? @map("deletado_em")
  deletadoPorId String?   @map("deletado_por_id")

  // Apagar de vez o Projeto leva os anexos (o serviço remove os arquivos do disco).
  projeto       Projeto   @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  autor         Usuario   @relation("anexoAutor", fields: [autorId], references: [id])
  deletadoPor   Usuario?  @relation("anexoExcluidoPor", fields: [deletadoPorId], references: [id], onDelete: SetNull)

  @@index([projetoId, criadoEm])
  @@index([deletadoEm])
  // + índice único PARCIAL (oportunidade_id, sha256) WHERE deletado_em IS NULL,
  // só na migração 20261101130000_anexos (o Prisma não representa índice parcial).
  @@map("anexo")
}

// ---------------------------------------------------------------- proposta (GAB-86)

/// Proposta do Projeto (spec fase 2 §4.3/§4.5): UMA por Projeto (único no banco).
/// O texto é Markdown CANÔNICO (fonte da verdade; ver src/lib/propostas/markdown.ts):
/// o editor (Tiptap) recebe o JSON derivado dele e o MCP lê/escreve o próprio Markdown.
/// `conteudo_md` + `estruturado` são o RASCUNHO (autosave; não é versão).
/// `revisao` = controle otimista: toda gravação do rascunho exige a revisão lida e a
/// incrementa (duas abas, pessoa + MCP: quem chega depois recebe conflito, nada é sobrescrito).
model Proposta {
  id             String         @id @default(cuid())
  projetoId      String         @unique @map("oportunidade_id")
  status         StatusProposta @default(RASCUNHO)
  conteudoMd     String         @default("") @map("conteudo_md")
  /// Rascunho da parte estruturada: { valor, prazoDias, escopoResumo, entregas[] } (src/lib/propostas/estruturado.ts).
  estruturado    Json           @default("{}")
  /// Cópia de `estruturado.valor` como coluna: lista/filtros/painel somam sem ler JSON.
  valor          Decimal?       @db.Decimal(14, 2)
  revisao        Int            @default(0)
  /// Última gravação do rascunho: quem, quando e se foi pelo conector MCP.
  rascunhoPorId  String?        @map("rascunho_por_id")
  rascunhoEm     DateTime?      @map("rascunho_em")
  rascunhoViaMcp Boolean        @default(false) @map("rascunho_via_mcp")
  /// Caneta (GAB-87): quem está com ela (null = ninguém; o GP do lado pega) e de que lado.
  /// Só o dono edita (src/lib/propostas/caneta.ts); passagens ficam em `PropostaCaneta`.
  canetaComId    String?        @map("caneta_com_id")
  canetaLado     Area?          @map("caneta_lado")
  /// GAB-87: motivo de "inviável" (status INVIAVEL), dado por projetos.
  motivoInviavel String?        @map("motivo_inviavel")
  /// GAB-89: envio ao cliente. `versaoEnviada` = número da versão final (a do PDF) marcada como
  /// enviada; base da regra da revisão (mudou escopo/prazo/valor desde ela → passa por projetos).
  versaoEnviada  Int?           @map("versao_enviada")
  enviadaEm      DateTime?      @map("enviada_em")
  /// Resposta do cliente (aceita/recusada/revisão pedida) e o motivo da recusa (o mesmo do `motivo_perda`).
  respondidaEm   DateTime?      @map("respondida_em")
  motivoRecusa   String?        @map("motivo_recusa")
  criadoPorId    String         @map("criado_por_id")
  criadoEm       DateTime       @default(now()) @map("criado_em")
  atualizadoEm   DateTime       @updatedAt @map("atualizado_em")

  // Apagar o Projeto de vez (admin) leva a proposta e as versões junto.
  projeto     Projeto          @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  criadoPor   Usuario          @relation("propostaCriadaPor", fields: [criadoPorId], references: [id])
  rascunhoPor Usuario?         @relation("propostaRascunhoPor", fields: [rascunhoPorId], references: [id], onDelete: SetNull)
  canetaCom   Usuario?         @relation("propostaCaneta", fields: [canetaComId], references: [id], onDelete: SetNull)
  versoes     PropostaVersao[]
  periodosCaneta PropostaCaneta[]
  comentarios PropostaComentario[]

  @@index([status])
  @@index([canetaComId])
  @@map("proposta")
}

/// Handoff do Projeto (GAB-93, spec fase 2 §4.8): GP designado, itens manuais do checklist e o resumo de
/// vendas. 1:1, criado na primeira edição; sem linha = nada preenchido. Proposta congelada e PDF do
/// contrato não moram aqui: são lidos da proposta e do anexo (`projetos/trava-handoff.ts`).
model ProjetoHandoff {
  projetoId        String    @id @map("oportunidade_id")
  gpProjetoId      String?   @map("gp_projeto_id")
  /// Item manual do checklist: quando foi marcado (null = pendente). Quem marcou fica na Timeline.
  contatosEm       DateTime? @map("contatos_em")
  kickoffEm        DateTime? @map("kickoff_em")
  acessosEm        DateTime? @map("acessos_em")
  resumoContexto   String    @default("") @map("resumo_contexto")
  resumoCombinados String    @default("") @map("resumo_combinados")
  resumoRiscos     String    @default("") @map("resumo_riscos")
  resumoValoriza   String    @default("") @map("resumo_valoriza")
  resumoPorId      String?   @map("resumo_por_id")
  resumoEm         DateTime? @map("resumo_em")
  atualizadoEm     DateTime  @updatedAt @map("atualizado_em")

  projeto   Projeto  @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  gpProjeto Usuario? @relation("handoffGp", fields: [gpProjetoId], references: [id], onDelete: SetNull)
  resumoPor Usuario? @relation("handoffResumoPor", fields: [resumoPorId], references: [id], onDelete: SetNull)

  @@index([gpProjetoId])
  @@index([resumoPorId])
  @@map("projeto_handoff")
}

/// De onde veio a entrega do cronograma (GAB-95).
enum OrigemEntrega {
  PROPOSTA // copiada da versão final da proposta
  MANUAL   // lançada pelo GP (card sem proposta, ou entrega nova)
}

enum StatusCheckin {
  VERDE
  AMARELO
  VERMELHO
}

/// Cronograma do Projeto em Execução (GAB-95, spec fase 2 §4.10): previsto × realizado.
/// `previsto_original` é imutável (trigger na migration 20261104180000); ajuste muda só `previsto_atual`
/// e deixa uma linha em `entrega_ajuste`. Dias civis de São Paulo em colunas DATE, para o painel consultar.
model ProjetoEntrega {
  id               String        @id @default(cuid())
  projetoId        String        @map("oportunidade_id")
  /// Ordem do cronograma. Única por Projeto: copiar duas vezes falha no banco em vez de duplicar.
  ordem            Int
  titulo           String
  valor            Decimal?      @db.Decimal(14, 2)
  previstoOriginal DateTime      @map("previsto_original") @db.Date
  previstoAtual    DateTime      @map("previsto_atual") @db.Date
  /// Dia em que foi entregue (null = pendente). Quem marcou fica na Timeline.
  realizadoEm      DateTime?     @map("realizado_em") @db.Date
  origem           OrigemEntrega
  /// Número da versão da proposta de onde veio (null em MANUAL).
  propostaVersao   Int?          @map("proposta_versao")
  /// Cancelada (com motivo): a linha fica, fora do cronograma ativo e das contas do painel. Quem cancelou fica na Timeline.
  canceladaEm      DateTime?     @map("cancelada_em")
  motivoCancelamento String?     @map("motivo_cancelamento")
  criadoEm         DateTime      @default(now()) @map("criado_em")
  atualizadoEm     DateTime      @updatedAt @map("atualizado_em")

  projeto Projeto         @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  ajustes EntregaAjuste[]

  @@unique([projetoId, ordem])
  @@map("projeto_entrega")
}

/// Ajuste de data de uma entrega, com motivo. Append-only (trigger recusa UPDATE).
model EntregaAjuste {
  id        String   @id @default(cuid())
  entregaId String   @map("entrega_id")
  de        DateTime @db.Date
  para      DateTime @db.Date
  motivo    String
  porId     String   @map("por_id")
  em        DateTime @default(now())

  entrega ProjetoEntrega @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  por     Usuario        @relation(fields: [porId], references: [id])

  @@index([entregaId, em])
  @@index([porId])
  @@map("entrega_ajuste")
}

/// Check-in do Projeto. Append-only (trigger recusa UPDATE): quem muda de ideia na semana registra outro, e vale o último.
model ProjetoCheckin {
  id        String        @id @default(cuid())
  projetoId String        @map("oportunidade_id")
  status    StatusCheckin
  motivo    String
  /// Segunda-feira (São Paulo) da semana do check-in.
  semana    DateTime      @db.Date
  porId     String        @map("por_id")
  em        DateTime      @default(now())

  projeto Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  por     Usuario @relation(fields: [porId], references: [id])

  @@index([projetoId, em])
  @@index([projetoId, semana])
  @@index([porId])
  @@map("projeto_checkin")
}

/// Lembrete de check-in já dado: a chave garante um por semana e por Projeto, a cada rodada do cron.
model LembreteCheckin {
  projetoId String   @map("oportunidade_id")
  /// Segunda-feira (São Paulo) da semana que ficou sem check-in.
  semana    DateTime @db.Date
  criadoEm  DateTime @default(now()) @map("criado_em")

  projeto Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@id([projetoId, semana])
  @@map("lembrete_checkin")
}

/// Versão da proposta: "Salvar versão" (v1, v2…). IMUTÁVEL — append-only como a
/// Timeline; um trigger no banco recusa UPDATE (ver a migration 20261101150000).
/// Snapshot completo: o Markdown e a parte estruturada daquele momento.
model PropostaVersao {
  id          String   @id @default(cuid())
  propostaId  String   @map("proposta_id")
  numero      Int
  conteudoMd  String   @map("conteudo_md")
  estruturado Json
  nota        String?
  autorId     String   @map("autor_id")
  /// Lado do autor ao salvar (GAB-87: "concordar só vale se a última versão veio do outro lado" e o diff de quem recebe a caneta).
  autorLado   Area?    @map("autor_lado")
  viaMcp      Boolean  @default(false) @map("via_mcp")
  criadoEm    DateTime @default(now()) @map("criado_em")

  proposta Proposta @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  autor    Usuario  @relation(fields: [autorId], references: [id])

  @@unique([propostaId, numero])
  @@index([autorId])
  @@map("proposta_versao")
}

/// GAB-87: cada período em que alguém ficou com a caneta (tempo com a caneta por pessoa,
/// para o painel). No máximo um aberto (`fim` null) por proposta: o serviço troca sob o
/// lock da linha da proposta. Ninguém com a caneta = nenhum período aberto.
model PropostaCaneta {
  id         String    @id @default(cuid())
  propostaId String    @map("proposta_id")
  usuarioId  String    @map("usuario_id")
  lado       Area
  inicio     DateTime  @default(now())
  fim        DateTime?

  proposta Proposta @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  usuario  Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([propostaId, fim])
  @@index([usuarioId])
  @@map("proposta_caneta")
}

// ---------------------------------------------------------------- comentários (GAB-91)

/// Comentário na proposta (spec fase 2 §4.6). Qualquer usuário ativo comenta, em qualquer
/// etapa, sem a caneta. Raiz = geral ou presa a um TRECHO; respostas em thread (um nível:
/// `pai_id` aponta sempre para a raiz). A âncora NÃO é marca no documento: é o trecho
/// citado + contexto curto, reencontrado no rascunho atual (src/lib/propostas/ancora.ts);
/// não achou = "trecho alterado". Preso à proposta, não à versão: sobrevive a versões
/// novas. Resolver/reabrir: estado aqui + Timeline do Projeto (histórico).
model PropostaComentario {
  id             String    @id @default(cuid())
  propostaId     String    @map("proposta_id")
  /// Resposta: a raiz da thread. null = comentário raiz.
  paiId          String?   @map("pai_id")
  autorId        String    @map("autor_id")
  /// Texto puro (o React escapa; nunca HTML). CHECK de tamanho na migration.
  texto          String
  /// Âncora (só na raiz; null = comentário geral).
  trecho         String?
  trechoAntes    String?   @map("trecho_antes")
  trechoDepois   String?   @map("trecho_depois")
  viaMcp         Boolean   @default(false) @map("via_mcp")
  /// Só na raiz: resolvido (null = aberto). Reabrir zera; o histórico fica na Timeline.
  resolvidoEm    DateTime? @map("resolvido_em")
  resolvidoPorId String?   @map("resolvido_por_id")
  criadoEm       DateTime  @default(now()) @map("criado_em")
  /// Muda a cada alteração: o polling compara contagem + máximo disto.
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em")

  proposta     Proposta             @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  pai          PropostaComentario?  @relation("respostas", fields: [paiId], references: [id], onDelete: Cascade)
  respostas    PropostaComentario[] @relation("respostas")
  autor        Usuario              @relation("comentarioAutor", fields: [autorId], references: [id])
  resolvidoPor Usuario?             @relation("comentarioResolvidoPor", fields: [resolvidoPorId], references: [id], onDelete: SetNull)

  @@index([propostaId, criadoEm])
  @@index([paiId])
  @@index([autorId])
  @@map("proposta_comentario")
}

// ---------------------------------------------------------------- avisos (GAB-88)
// Sino no app + WhatsApp privado (spec fase 2 §4.11). Emitidos só por src/lib/avisos.

/// Tipo do aviso. Só SUA_VEZ, PROPOSTA_ACEITA e HANDOFF vão também ao WhatsApp privado.
enum TipoAviso {
  SUA_VEZ         // a caneta da proposta chegou em você
  CANETA_PEGA     // o GP pegou a caneta que estava com você
  STATUS_PROPOSTA // proposta em que você atuou mudou de status
  COMENTARIO      // comentário na proposta que está com você (ticket de comentários)
  PROPOSTA_ACEITA // cliente aceitou (envio)
  HANDOFF         // handoff do projeto
  CHECKIN_ATRASADO // GAB-95: a semana passou sem check-in (só no app)
  GP_TROCADO       // GAB-95: você deixou de ser o GP do projeto (só no app)
  TAREFA_ATRIBUIDA // alguém te atribuiu uma tarefa do kanban interno do projeto
  EQUIPE_PROJETO   // você entrou na equipe de um projeto
  LEMBRETE_GG      // lembrete de evento da agenda de G&G (RG, reunião)
}

/// O que aconteceu com o WhatsApp privado de um aviso (null no aviso = tipo só do app).
enum EnvioAviso {
  PENDENTE     // envio real em andamento
  ENVIADO
  SAFE_MODE    // NOTIFICATIONS_ENABLED≠true: só logado (ref)
  SEM_TELEFONE // usuário sem telefone: só no app
  DESLIGADO    // usuário desligou nas preferências
  FALHOU       // Evolution falhou: log com a ref
}

model Aviso {
  id          String      @id @default(cuid())
  usuarioId   String      @map("usuario_id")
  tipo        TipoAviso
  /// Texto pronto (nomes do momento do aviso): o sino e o WhatsApp mostram este.
  titulo      String
  projetoId   String?     @map("oportunidade_id")
  whatsapp    EnvioAviso?
  /// Ref do log quando o WhatsApp não saiu de verdade (safe mode ou falha).
  whatsappRef String?     @map("whatsapp_ref")
  lidoEm      DateTime?   @map("lido_em")
  criadoEm    DateTime    @default(now()) @map("criado_em")

  usuario Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  projeto Projeto? @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  // Contador do sino (polling): usuario_id + lido_em IS NULL. Lista: mais recentes do usuário.
  @@index([usuarioId, lidoEm])
  @@index([usuarioId, criadoEm])
  @@index([projetoId])
  @@map("aviso")
}

// ================================================================ Equipe do projeto
// Quem trabalha em cada projeto (a "escala" que as specs do hub e do kanban esperavam).
// Período [inicio, fim): sair da equipe encerra, não apaga. Uma vaga aberta por pessoa e projeto
// (índice parcial na migration). A função é do projeto, não do organograma: Scrum Master na IJ
// pode ser só dev num projeto.

enum FuncaoProjeto {
  PM
  PO
  SCRUM_MASTER
  MEMBRO
}

model ProjetoMembro {
  id         String        @id @default(cuid())
  projetoId  String        @map("oportunidade_id")
  usuarioId  String        @map("usuario_id")
  funcao     FuncaoProjeto @default(MEMBRO)
  inicio     DateTime      @db.Date
  fim        DateTime?     @db.Date
  criadoEm   DateTime      @default(now()) @map("criado_em")

  projeto Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation("equipeUsuario", fields: [usuarioId], references: [id])

  @@index([projetoId])
  @@index([usuarioId])
  @@map("projeto_membro")
}

// ================================================================ G&G · fatia A (estrutura)
// Vindo do automacao-GG (supabase/migrations 001, 005, 007). Nomes "Org" porque Area e Cargo
// já são enums do CRM (lado do usuário e GP).

enum StatusMembro {
  NAO_INFORMADO
  ATIVO
  AFASTADO
  INATIVO
}

enum TipoAreaOrg {
  AREA
  FRENTE
  INSTITUCIONAL
}

/// Diretoria (diretor, presidente, VP), liderança dentro da diretoria (PM, PO, Scrum Master,
/// gerências) ou membro. Novo em relação ao G&G.
enum CategoriaCargo {
  DIRETORIA
  LIDERANCA
  MEMBRO
}

/// Pessoa da IJ, com ou sem conta no CRM. Conta (`usuario`) é outra coisa: liga por `usuarioId`.
model Membro {
  id                 String       @id @default(cuid())
  nome               String
  email              String?
  status             StatusMembro @default(NAO_INFORMADO)
  interesseLideranca Boolean?     @map("interesse_lideranca")
  usuarioId          String?      @unique @map("usuario_id")
  criadoEm           DateTime     @default(now()) @map("criado_em")
  atualizadoEm       DateTime     @updatedAt @map("atualizado_em")

  usuario    Usuario?       @relation("membroConta", fields: [usuarioId], references: [id], onDelete: SetNull)
  ocupacoes  Ocupacao[]
  vinculos   VinculoIj[]
  demandas   Demanda[]
  ausencias  Ausencia[]
  objetivos  Objetivo[]
  iniciativas Iniciativa[]

  @@index([nome])
  @@map("membro")
}

model AreaOrg {
  id         String      @id @default(cuid())
  nome       String
  tipo       TipoAreaOrg @default(AREA)
  superiorId String?     @map("superior_id")
  /// Lado do CRM que esta área dá a quem está nela (Projetos → PROJETOS, Vendas → VENDAS).
  ladoCrm    Area?       @map("lado_crm")
  /// Área de Gente & Gestão: quem está nela (ou nas frentes) edita a área G&G do CRM.
  ehGG       Boolean     @default(false) @map("eh_gg")
  ativo      Boolean     @default(true)

  superior  AreaOrg?       @relation("areaSuperior", fields: [superiorId], references: [id])
  filhas    AreaOrg[]      @relation("areaSuperior")
  posicoes  Posicao[]
  eventos   EventoAgenda[]

  @@map("area_org")
}

model CargoOrg {
  id        String         @id @default(cuid())
  nome      String
  categoria CategoriaCargo @default(MEMBRO)
  /// Quem ocupa este cargo é GP do lado no CRM (proposta: PM).
  ehGp      Boolean        @default(false) @map("eh_gp")
  ativo     Boolean        @default(true)

  posicoes Posicao[]
  raci     Raci[]

  @@map("cargo_org")
}

/// Cargo + área + liderança: é o cartão do organograma.
model Posicao {
  id           String  @id @default(cuid())
  nome         String
  areaId       String  @map("area_id")
  cargoId      String  @map("cargo_id")
  liderancaId  String? @map("lideranca_id")
  ativo        Boolean @default(true)

  area      AreaOrg    @relation(fields: [areaId], references: [id])
  cargo     CargoOrg   @relation(fields: [cargoId], references: [id])
  lideranca Posicao?   @relation("lideranca", fields: [liderancaId], references: [id])
  liderados Posicao[]  @relation("lideranca")
  ocupacoes Ocupacao[]

  @@index([liderancaId])
  @@map("posicao")
}

/// Pessoa numa posição em [inicio, fim). Invalidada = "retirada por erro": fora do organograma
/// e da trajetória, mas guardada.
model Ocupacao {
  id                String    @id @default(cuid())
  membroId          String    @map("membro_id")
  posicaoId         String    @map("posicao_id")
  inicio            DateTime? @db.Date
  fim               DateTime? @db.Date
  principal         Boolean   @default(false)
  invalidadoEm      DateTime? @map("invalidado_em")
  motivoInvalidacao String?   @map("motivo_invalidacao")
  criadoEm          DateTime  @default(now()) @map("criado_em")

  membro  Membro  @relation(fields: [membroId], references: [id])
  posicao Posicao @relation(fields: [posicaoId], references: [id])

  @@index([membroId])
  @@index([posicaoId])
  @@map("ocupacao")
}

/// Períodos na IJ (entradas e saídas, com reingresso).
model VinculoIj {
  id       String    @id @default(cuid())
  membroId String    @map("membro_id")
  entrada  DateTime? @db.Date
  saida    DateTime? @db.Date

  membro Membro @relation(fields: [membroId], references: [id])

  @@index([membroId])
  @@map("vinculo_ij")
}

/// Histórico organizacional, escrito pelo serviço na mesma transação da mudança.
model HistoricoOrg {
  id         String   @id @default(cuid())
  membroId   String?  @map("membro_id")
  evento     String
  dados      Json     @default("{}")
  autorId    String?  @map("autor_id")
  criadoEm   DateTime @default(now()) @map("criado_em")

  autor Usuario? @relation(fields: [autorId], references: [id], onDelete: SetNull)

  @@index([membroId, criadoEm])
  @@map("historico_org")
}

/// Chave idempotente da importação de membros: repetir o lote devolve a contagem anterior.
model ImportacaoMembros {
  id         String   @id
  autorId    String   @map("autor_id")
  quantidade Int
  criadoEm   DateTime @default(now()) @map("criado_em")

  @@map("importacao_membros")
}

// ================================================================ G&G · fase B (rotina)

enum TipoDemanda {
  ROSA
  AZUL
}

/// Registro simples Rosa/Azul (o fluxo antigo P0–P3 do G&G não migra). Limite por membro e semestre:
/// 2 rosas e 3 azuis, contando as não canceladas (serviço com trava por transação).
model Demanda {
  id              String      @id @default(cuid())
  membroId        String      @map("membro_id")
  tipo            TipoDemanda
  semestre        String
  justificativa   String
  autorId         String      @map("autor_id")
  registranteNome String      @map("registrante_nome")
  canceladaEm     DateTime?   @map("cancelada_em")
  criadoEm        DateTime    @default(now()) @map("criado_em")

  membro Membro  @relation(fields: [membroId], references: [id])
  autor  Usuario @relation(fields: [autorId], references: [id])

  @@index([membroId, semestre])
  @@map("demanda")
}

enum CategoriaEvento {
  RG
  REUNIAO
  EVENTO
}

/// Agenda de G&G. Área vazia = IJ inteira. Só ausências são registradas (ninguém é marcado presente).
model EventoAgenda {
  id          String          @id @default(cuid())
  titulo      String
  data        DateTime        @db.Date
  horario     String?
  categoria   CategoriaEvento @default(EVENTO)
  areaId      String?         @map("area_id")
  criadoPorId String          @map("criado_por_id")
  deletadoEm  DateTime?       @map("deletado_em")
  criadoEm    DateTime        @default(now()) @map("criado_em")

  area      AreaOrg?   @relation(fields: [areaId], references: [id])
  criadoPor Usuario    @relation(fields: [criadoPorId], references: [id])
  ausencias Ausencia[]
  lembretes LembreteEvento[]

  @@index([data])
  @@map("evento_agenda")
}

model Ausencia {
  id              String   @id @default(cuid())
  eventoId        String   @map("evento_id")
  membroId        String   @map("membro_id")
  justificada     Boolean
  observacao      String?
  registradoPorId String   @map("registrado_por_id")
  criadoEm        DateTime @default(now()) @map("criado_em")

  evento        EventoAgenda @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  membro        Membro       @relation(fields: [membroId], references: [id])
  registradoPor Usuario      @relation(fields: [registradoPorId], references: [id])

  @@unique([eventoId, membroId])
  @@map("ausencia")
}

/// Marca "lembrete deste evento já dado a esta pessoa" (o cron não repete).
model LembreteEvento {
  eventoId  String   @map("evento_id")
  usuarioId String   @map("usuario_id")
  em        DateTime @default(now())

  evento EventoAgenda @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@id([eventoId, usuarioId])
  @@map("lembrete_evento")
}

model Ciclo {
  id     String   @id @default(cuid())
  nome   String
  inicio DateTime @db.Date
  fim    DateTime @db.Date

  objetivos Objetivo[]

  @@map("ciclo")
}

model Objetivo {
  id            String @id @default(cuid())
  titulo        String
  cicloId       String @map("ciclo_id")
  responsavelId String @map("responsavel_id")

  ciclo       Ciclo            @relation(fields: [cicloId], references: [id])
  responsavel Membro           @relation(fields: [responsavelId], references: [id])
  resultados  ResultadoChave[]
  iniciativas Iniciativa[]

  @@map("objetivo")
}

/// `fonte` preenchida = o CRM mede sozinho (ver lib/gg/fontes-crm.ts); senão, valor atual manual.
model ResultadoChave {
  id         String  @id @default(cuid())
  objetivoId String  @map("objetivo_id")
  titulo     String
  unidade    String  @default("")
  inicial    Decimal @db.Decimal(14, 2)
  meta       Decimal @db.Decimal(14, 2)
  atual      Decimal @db.Decimal(14, 2)
  fonte      String?

  objetivo Objetivo @relation(fields: [objetivoId], references: [id], onDelete: Cascade)

  @@map("resultado_chave")
}

enum DirecaoKpi {
  MAIOR
  MENOR
}

model Kpi {
  id      String     @id @default(cuid())
  titulo  String
  unidade String
  meta    Decimal    @db.Decimal(14, 2)
  direcao DirecaoKpi @default(MAIOR)
  fonte   String?

  medicoes    MedicaoKpi[]
  iniciativas Iniciativa[]

  @@map("kpi")
}

model MedicaoKpi {
  id    String   @id @default(cuid())
  kpiId String   @map("kpi_id")
  data  DateTime @db.Date
  valor Decimal  @db.Decimal(14, 2)

  kpi Kpi @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([kpiId, data])
  @@map("medicao_kpi")
}

model Iniciativa {
  id            String    @id @default(cuid())
  titulo        String
  objetivoId    String?   @map("objetivo_id")
  kpiId         String?   @map("kpi_id")
  responsavelId String    @map("responsavel_id")
  prazo         DateTime? @db.Date
  concluidaEm   DateTime? @map("concluida_em")

  objetivo    Objetivo? @relation(fields: [objetivoId], references: [id], onDelete: SetNull)
  kpi         Kpi?      @relation(fields: [kpiId], references: [id], onDelete: SetNull)
  responsavel Membro    @relation(fields: [responsavelId], references: [id])

  @@map("iniciativa")
}

model Processo {
  id    String  @id @default(cuid())
  nome  String
  ativo Boolean @default(true)

  raci Raci[]

  @@map("processo")
}

enum PapelRaci {
  R
  A
  C
  I
}

/// Um A por processo (índice parcial na migration).
model Raci {
  processoId String    @map("processo_id")
  cargoId    String    @map("cargo_id")
  papel      PapelRaci

  processo Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  cargo    CargoOrg @relation(fields: [cargoId], references: [id])

  @@id([processoId, cargoId])
  @@map("raci")
}
